# VOZTRI - Variáveis de Ambiente

APP_NAME=VOZTRI
APP_ENV=local
APP_KEY=base64:VOZTRISuperSecretKeyForDevelopmentOnly123=
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo
APP_URL=http://localhost:8080

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Banco de Dados PostgreSQL + PostGIS
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=voztri_db
DB_USERNAME=voztri_user
DB_PASSWORD=voztri_secure_pass

# Cache & Filas Redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

# WebSockets - Laravel Reverb
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=voztri_app
REVERB_APP_KEY=voztri_key_reverb_live
REVERB_APP_SECRET=voztri_secret_reverb_live
REVERB_HOST=localhost
REVERB_PORT=8081
REVERB_SCHEME=http

# Storage MinIO (S3 compatível)
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=voztri_admin
AWS_SECRET_ACCESS_KEY=voztri_password_safe
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=voztri-media
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# Email - Mailpit
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="nao-responda@voztri.com.br"
MAIL_FROM_NAME="VOZTRI"

# Mapas & Roteamento (OSRM e Photon Locais)
OSRM_ROUTING_URL=http://osrm:5000
PHOTON_GEOCODING_URL=http://photon:2322
DEFAULT_CITY="São Paulo"
DEFAULT_LATITUDE=-23.550520
DEFAULT_LONGITUDE=-46.633308

# Gateway de Pagamentos (Sandbox inicial / Asaas / Mercado Pago)
PAYMENT_GATEWAY=mock
ASAAS_API_KEY=
MERCADO_PAGO_ACCESS_TOKEN=
WEBHOOK_SECRET=voztri_webhook_secure_token_123

# Limites e Regras Operacionais
DISPATCH_INITIAL_RADIUS_KM=2
DISPATCH_MAX_RADIUS_KM=12
OFFER_TIMEOUT_SECONDS=15
MINIMUM_FARE_CENTS=750
PLATFORM_COMMISSION_PERCENT=15.0

