{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["vite/client"],
    "noEmit": true,
    "paths": {
      "@voztri/api-client": ["../../packages/api-client/src/index.ts"],
      "@voztri/design-tokens": ["../../packages/design-tokens/src/index.ts"],
      "@voztri/shared-types": ["../../packages/shared-types/src/index.ts"],
      "axios": ["./node_modules/axios"]
    }
  },
  "include": ["src/**/*", "vite.config.ts"]
}
