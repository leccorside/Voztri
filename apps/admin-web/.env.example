# Porta do painel administrativo (a 3000 costuma estar ocupada por outros stacks)
ADMIN_WEB_PORT=3010

# Base usada pelo navegador para chamar a API. O padrão "/api/v1" passa pelo
# proxy do Vite (sem CORS). Para chamar a API direto, use http://localhost:8080/api/v1
VITE_API_URL=/api/v1

# Para onde o proxy /api do Vite encaminha (Nginx do docker-compose)
VITE_API_PROXY_TARGET=http://localhost:8080
