<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>pt_BR</string>
	<key>CFBundleDisplayName</key>
	<string>VOZTRI Driver</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>br.com.voztri.driver</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- Permissões de Localização para Despacho e Rota Contínua -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>O VOZTRI Driver necessita de sua localização para despachar passageiros próximos e traçar a rota até o embarque.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>O rastreamento contínuo em segundo plano é fundamental para que você receba solicitações de corrida mesmo com outros navegadores em primeiro plano.</string>

	<!-- Permissões de Câmera para Envio de Documentos CNH/CRLV -->
	<key>NSCameraUsageDescription</key>
	<string>Acesso à câmera para captura de fotos da CNH, CRLV e validação de segurança.</string>

	<!-- Background Modes -->
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>remote-notification</string>
		<string>processing</string>
	</array>

	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
