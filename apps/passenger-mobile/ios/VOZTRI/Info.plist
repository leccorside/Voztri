<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>pt_BR</string>
	<key>CFBundleDisplayName</key>
	<string>VOZTRI</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>br.com.voztri.passenger</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- Permissões de Localização (Apple Privacy Guidelines) -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>O VOZTRI utiliza sua localização para exibir o mapa, calcular rotas precisas e conectar você aos motoristas mais próximos.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>O VOZTRI utiliza sua localização em segundo plano durante as corridas para garantir sua segurança e acompanhar o trajeto em tempo real.</string>

	<!-- Permissões de Câmera e Notificações -->
	<key>NSCameraUsageDescription</key>
	<string>O VOZTRI necessita de acesso à câmera para leitura de QR Code Pix e fotos de perfil.</string>

	<!-- Background Modes para Rastreamento e APNs -->
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>remote-notification</string>
	</array>

	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>

